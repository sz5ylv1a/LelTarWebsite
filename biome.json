{
	"$schema": "https://biomejs.dev/schemas/2.3.11/schema.json",
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineEnding": "lf"
	},
	"json": {
		"formatter": {
			"indentWidth": 2
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"style": {
				"useConst": "off",
				"useImportType": "off",
				"noNonNullAssertion": "off"
			},
			"correctness": {
				"noUnusedVariables": "off",
				"noUnusedImports": "off"
			}
		}
	},
	"assist": {
		"enabled": true,
		"includes": ["**/*.svelte", "**/*.astro", "**/*.vue"],
		"actions": {
			"source": {
				"organizeImports": "off"
			}
		}
	}
}